{
  "name": "fate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "四柱预测引擎 —— 可复现、可审计、可校准",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "guard": "vitest run packages/core/test/report.spec.ts packages/core/test/persona.spec.ts && node scripts/check-web-text.mjs",
    "gen:vsop87": "node scripts/generate-vsop87.mjs",
    "check:web": "node scripts/check-web-text.mjs",
    "pretest": "tsc -b",
    "gen:book": "node scripts/build-book.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "js-yaml": "^5.4.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
